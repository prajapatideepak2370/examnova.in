# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/exam_portal
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/exam_portal?retryWrites=true&w=majority

# ---- Auth ----
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# ---- CORS ----
# For local development: http://localhost:5173
# For Vercel: set this to your public frontend domain, e.g. https://your-project.vercel.app
CLIENT_URL=http://localhost:5173

# ---- Uploads ----
MAX_UPLOAD_MB=25
# Absolute path to the LibreOffice soffice binary (optional).
# When set, .doc/.docx uploads are converted to PDF so they can be previewed online.
# Example (Windows): LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
LIBREOFFICE_PATH=

# ---- Seed admin (used by `npm run seed`) ----
ADMIN_NAME=Portal Admin
ADMIN_EMAIL=admin@examportal.in
ADMIN_PASSWORD=Admin@12345
